#!/usr/bin/env php
<?php

declare(strict_types=1);

use Phplrt\Compiler\Compiler;
use Phplrt\Compiler\Generator\ClassModifier;
use Phplrt\Compiler\Generator\TargetPhpVersion;
use Phplrt\Source\FileSource;
use Symfony\Component\Console\Logger\ConsoleLogger;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\Output\StreamOutput;

if (!in_array(PHP_SAPI, ['cli', 'phpdbg', 'embed'], true)) {
    trigger_error('The console should be invoked via the CLI '
        . 'version of PHP, not the ' . PHP_SAPI . ' SAPI.', E_USER_WARNING);
}

$directory = __DIR__;
while (dirname($directory) !== $directory) {
    foreach ([$directory . '/autoload.php', $directory . '/vendor/autoload.php'] as $pathname) {
        if (is_file($pathname)) {
            require $pathname;
            break;
        }
    }

    $directory = dirname($directory);
}

if (!class_exists(Compiler::class)) {
    file_put_contents(
        filename: 'php://stderr',
        data: 'Composer "phplrt/compiler" dependency required to execute this script.' . PHP_EOL,
    );

    exit(-1);
}

$compiler = new Compiler();

if (\class_exists(ConsoleLogger::class)) {
    $compiler->setLogger(new ConsoleLogger(new StreamOutput(
        stream: \STDOUT,
        verbosity: OutputInterface::VERBOSITY_VERY_VERBOSE,
    )));
}

$compiler
    ->load(FileSource::createFromPathname(__DIR__ . '/../resources/grammar.pp3'))
    ->generate()
        ->withNamespaceName('TypeLang\\Parser\\Internal')
        ->withClassName('CompiledExecutor')
        ->withClassModifier(ClassModifier::Abstract)
        // The parser carries the features it recognizes a source with, so it
        // is declared as a mutable class rather than a readonly one.
        ->withReadonly(false)
        ->withTargetPhpVersion(TargetPhpVersion::Php81)
        ->withClassImport('TypeLang\\Parser\\Exception')
        ->withClassImport('TypeLang\\Type')
    ->save(__DIR__ . '/../src/Internal/CompiledExecutor.php');
