/**
 * -----------------------------------------------------------------------------
 *  Conditional Types
 *
 *  T is U ? A : B, T is not U ? A : B, $a is U ? A : B
 * -----------------------------------------------------------------------------
 */

// Any type, an entry point
// int, T is U ? A : B, T is not U ? A : B, $a is U ? A : B
#Type -> {
    if (!isset($children[1])) {
        return $children[0];
    }

    if (!$this->features->conditions) {
        throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabledIn('conditions', $ctx);
    }

    return match (\count($children)) {
        // T is U ? A : B
        4 => new Type\Condition\ConditionalTypeNode(
            new Type\Condition\ConditionNode(
                $children[0],
                $children[1],
                Type\Condition\ConditionNode\ConditionKind::Equal,
                $offset,
            ),
            $children[2],
            $children[3],
            $offset,
        ),
        // T is not U ? A : B, the children have the "is not" in front of the target
        default => new Type\Condition\ConditionalTypeNode(
            new Type\Condition\ConditionNode(
                $children[0],
                $children[2],
                Type\Condition\ConditionNode\ConditionKind::NotEqual,
                $offset,
            ),
            $children[3],
            $children[4],
            $offset,
        ),
    };
}
  : UnionType() ConditionTail()?
  | Variable() ConditionTail()
  ;

// is U ? A : B, is not U ? A : B, is not ?U ? A : B
ConditionTail
  : <T_IS_NOT> ConditionOperand()
    // then
    ::T_QUESTION:: @error("A \"?\" is expected after the target of the condition") Type()
    // else
    ::T_COLON:: @error("The condition requires an else branch, \":\" expected") Type()
  | ::T_IS:: ConditionOperand()
    // then
    ::T_QUESTION:: @error("A \"?\" is expected after the target of the condition") Type()
    // else
    ::T_COLON:: @error("The condition requires an else branch, \":\" expected") Type()
  ;

// U, $b
ConditionOperand
  : Variable()
  | UnionType()
  ;
