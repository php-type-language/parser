
// The end of a word: no name character, hyphen or "\Name" follows
// ("is" in "is-x" and in "is\Foo" is not a word)
%fragment WORD_END      (?!(?&NAME_CHAR)|-|\\(?&NAME_START))


/**
 * -----------------------------------------------------------------------------
 *  Namespaces and Masks
 * -----------------------------------------------------------------------------
 */

// Foo\, \Foo\Bar\, \
%token T_NAMESPACE      (?:\\(?:(?&NAME_WORD)\\)*+|(?:(?&NAME_WORD)\\)++)(?=(?&NAME_START)|\*)

// PHP_*, *
%fragment MASK_HEAD     (?:(?&NAME_START)(?&NAME_CHAR)*+\*|\*)

// _SUFFIX, _A*B*C
%fragment MASK_REST     (?:(?&NAME_CHAR)++\*)*+(?&NAME_CHAR)*+

// PHP_*, *_SUFFIX, A*B, true*, is_*. A lone star is a wildcard
%token T_IDENTIFIER_MASK (?!\*(?!(?&NAME_CHAR)))(?&MASK_HEAD)(?&MASK_REST)


/**
 * -----------------------------------------------------------------------------
 *  Common Literals
 * -----------------------------------------------------------------------------
 */

%token T_TRUE           (?i:true)(?&WORD_END)
%token T_FALSE          (?i:false)(?&WORD_END)
%token T_NULL           (?i:null)(?&WORD_END)


/**
 * -----------------------------------------------------------------------------
 *  Variables
 * -----------------------------------------------------------------------------
 */

// $this
%token T_THIS           \$this(?&WORD_END)

// $name
%token T_VARIABLE       \$(?&NAME_START)(?&NAME_CHAR)*+


/**
 * -----------------------------------------------------------------------------
 *  Numbers
 * -----------------------------------------------------------------------------
 */

// 1_000: a single "_" is allowed between two digits
%fragment DIGITS        [0-9](?:_?+[0-9])*+

// e3, E-3
%fragment EXPONENT      [eE][+-]?+(?&DIGITS)

// +, -, "- 1": whitespaces may follow the sign
%fragment SIGN          (?:[+-]\s*+)?+

// 1.5, 1., .5, 1e3, 1.5e-3, 1_000.5
%token T_FLOAT         (?&SIGN)(?:(?&DIGITS)\.(?:(?&DIGITS))?+(?:(?&EXPONENT))?+|\.(?&DIGITS)(?:(?&EXPONENT))?+|(?&DIGITS)(?&EXPONENT))

// 0x1F, 0XDE_AD
%token T_INT_HEX        (?&SIGN)0[xX][0-9a-fA-F](?:_?+[0-9a-fA-F])*+

// 0b101, 0B10_10
%token T_INT_BIN        (?&SIGN)0[bB][01](?:_?+[01])*+

// 0o17, 0O17, 0o6_5_5
%token T_INT_OCT        (?&SIGN)0[oO][0-7](?:_?+[0-7])*+

// 017, 0_42, 00, 0
%token T_INT_OCT_LEGACY (?&SIGN)0(?:_?+[0-7])*+

// 42, 1_000
%token T_INT_DEC        (?&SIGN)[1-9](?:_?+[0-9])*+


/**
 * -----------------------------------------------------------------------------
 *  Strings
 * -----------------------------------------------------------------------------
 */

// 'text'
%token T_SQ_STRING      '([^'\\]*(?:\\.[^'\\]*)*)'

// "text"
%token T_DQ_STRING      "([^"\\]*(?:\\.[^"\\]*)*)"


/**
 * -----------------------------------------------------------------------------
 *  Other Keywords
 * -----------------------------------------------------------------------------
 */

// Whitespaces and comments between the words of "is not"
%fragment TRIVIA        (?:\s++|/\*(?:[^*]++|\*(?!/))*+\*/|(?://|#)[^\r\n]*+)

// is not, is /* c */ not. It stands before "is", the longest token is read
%token T_IS_NOT         is(?&WORD_END)(?&TRIVIA)++not(?&WORD_END)

// Lower case only: IS is an ordinary name
%token T_IS             is(?&WORD_END)
%token T_NOT            not(?&WORD_END)
%token T_OF             of(?&WORD_END)
%token T_AS             as(?&WORD_END)
%token T_SUPER          super(?&WORD_END)

// covariant, contravariant, invariant
%token T_COVARIANT      covariant(?&WORD_END)
%token T_CONTRAVARIANT  contravariant(?&WORD_END)
%token T_INVARIANT      invariant(?&WORD_END)


/**
 * -----------------------------------------------------------------------------
 *  Names
 * -----------------------------------------------------------------------------
 */

// The first character of a name
%fragment NAME_START    [A-Za-z_\x80-\xFF]

// Any other character of a name
%fragment NAME_CHAR     [\w\x80-\xFF]

// A word with no hyphens
%fragment NAME_WORD     (?&NAME_START)(?&NAME_CHAR)*+

// non-empty-string: a word with hyphens between the characters
%token T_VIRTUAL_NAME   (?&NAME_WORD)(?:-(?&NAME_CHAR)++)++

// Foo, PHP_EOL
%token T_IDENTIFIER     (?&NAME_WORD)


/**
 * -----------------------------------------------------------------------------
 *  Punctuation
 * -----------------------------------------------------------------------------
 */

%token T_WILDCARD       \*
%token T_DOUBLE_COLON   ::
%token T_COLON          :
%token T_ELLIPSIS       \.\.\.
%token T_ASSIGN         =
%token T_UNION          \|
%token T_AMPERSAND      &
%token T_QUESTION       \?
%token T_COMMA          ,
%token T_PAREN_OPEN     \(
%token T_PAREN_CLOSE    \)
%token T_ANGLE_OPEN     <
%token T_ANGLE_CLOSE    >
%token T_BRACKET_OPEN   \[
%token T_BRACKET_CLOSE  \]
%token T_BRACE_OPEN     \{
%token T_BRACE_CLOSE    \}


/**
 * -----------------------------------------------------------------------------
 *  Skips
 * -----------------------------------------------------------------------------
 */

%skip   T_WHITESPACE            \s++

// // text, # text
%skip   T_COMMENT               (?://|#)[^\r\n]*+

// /* text */
%skip   T_DOC_COMMENT           /\*(?:[^*]++|\*(?!/))*+\*/
