/**
 * -----------------------------------------------------------------------------
 *  Language Syntax Summary
 * -----------------------------------------------------------------------------
 */


%include grammar/lexemes
%include grammar/names
%include grammar/literals
%include grammar/constants
%include grammar/templates
%include grammar/callable
%include grammar/shapes
%include grammar/logical
%include grammar/wrapping
%include grammar/conditions

%pragma lexer.pcre.disable u
%pragma root Type


/**
 * -----------------------------------------------------------------------------
 *  Atoms
 * -----------------------------------------------------------------------------
 */


Atom
  : Literal()
  | NamedType()
  | ThisType()
  | ConstMaskType()
  | Group()
  ;

// Foo, \Foo\Bar, Foo::BAR, Foo::BAR_*, Foo::*, Foo<T>, \Foo\Bar<T, U>,
// Foo{...}, \Foo\Bar{...}, Foo(int): void, Foo<T>(T): T
NamedType -> {
    $name = $children[0];
    $second = $children[1] ?? null;

    // Foo::BAR
    if ($second instanceof Type\Identifier && !$this->features->constants) {
        throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabledIn('constants', $ctx);
    }

    return match (true) {
        // Foo, \Foo\Bar
        $second === null => new Type\NamedTypeNode($name, null, null, $offset),
        // Foo<T>, \Foo\Bar<T, U>
        $second instanceof Type\Template\TemplateListNode => new Type\NamedTypeNode($name, $second, null, $offset),
        // Foo{...}, Foo{...<K, V>}
        $second instanceof Type\Shape\FieldListNode => new Type\NamedTypeNode($name, $children[2], $second, $offset),
        // Foo(int): void, Foo()
        $second instanceof Type\Callable\CallableParameterListNode => new Type\Callable\CallableTypeNode($name, $second, $children[2] ?? null, null, $offset),
        // Foo<T>(T): T
        $second instanceof Type\Template\TemplateParameterListNode => new Type\Callable\CallableTypeNode($name, $children[2], $children[3] ?? null, $second, $offset),
        // Foo::BAR
        $second instanceof Type\Identifier => new Type\Constant\ClassConstTypeNode($name, $second, $offset),
        // Foo::BAR_*, Foo::*
        default => new Type\Constant\ClassConstMaskTypeNode($name, $second, $offset),
    };
}
  : Name() (
      ::T_DOUBLE_COLON:: ConstantMask()
      // Foo<T>, no parameters of a callable follow
      | TemplateArguments() !<T_PAREN_OPEN>
      | TemplateParameters() CallableSignature()
      | TemplateArguments()
      | ShapeFields()
      | CallableSignature()
    )?
  ;

// $this
ThisType -> {
    return new Type\ThisTypeNode($offset);
}
  : <T_THIS>
  ;

// $a, $_x, $thisFoo
Variable -> {
    return new Type\VariableNode(\substr($children->value, 1), $offset);
}
  : <T_VARIABLE>
  ;

// (int), ((int))
Group
  : ::T_PAREN_OPEN::
      Type() @error("A type is expected after \"(\"")
    ::T_PAREN_CLOSE::
    @error("The group is not closed properly, \")\" expected")
  ;
